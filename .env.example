# Supabase. The same project the API and the marketing site use: the admin
# reads the same tables, so these point at one database, not a copy.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Reads past row-level security, so it is a server secret and never shipped to
# a browser. Without it the waitlist and the metrics come back empty.
SUPABASE_SERVICE_ROLE_KEY=
